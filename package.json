{
  "name": "basalt",
  "private": true,
  "version": "0.1.0",
  "description": "Basalt: an AI-friendly, local-first Markdown notes app.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check-setup.mjs",
    "predev": "node scripts/check-setup.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && npm run dev -w @basalt/desktop",
    "build": "npm run tokens && npm run build -w @basalt/cli && npm run build -w @basalt/desktop",
    "test": "vitest run",
    "test:e2e": "npm run build -w @basalt/desktop && node apps/desktop/e2e/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "basalt": "node packages/cli/dist/basalt.mjs",
    "postinstall": "node scripts/build-tokens.mjs",
    "prebuild": "node scripts/check-setup.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "lodash.isequal": "file:scripts/shims/lodash.isequal",
    "rimraf": "file:scripts/shims/rimraf-v2"
  },
  "overrides": {
    "@electron/asar": "^4.3.2",
    "@electron/get": "^5.1.0",
    "@electron/universal": "^3.0.6",
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    },
    "temp": {
      "rimraf": "$rimraf"
    },
    "lodash.isequal": "$lodash.isequal"
  }
}
