# Caddy gets and renews a Let's Encrypt certificate for SYNC_DOMAIN automatically.
{$SYNC_DOMAIN} {
	encode zstd gzip
	request_body {
		# Sync is for notes. Keep this a little above MAX_FILE_BYTES (2 MiB by default) so the
		# server can answer oversized uploads with a clear message.
		max_size 8MB
	}
	reverse_proxy sync:8080 {
		# Keep server-sent event streams open.
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
