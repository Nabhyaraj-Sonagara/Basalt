# Copy to .env and fill in, or let setup.sh write it. Keep .env private (chmod 600 .env).

# The DNS name pointing at this server, e.g. sync.example.com
SYNC_DOMAIN=sync.example.com

# Generate each with: openssl rand -hex 32   (setup.sh fills these in)
POSTGRES_PASSWORD=
SERVER_SECRET=

# Sync is for notes, not file storage. The apps only sync notes, canvases, HTML pages and other
# small text files; these limits make the server refuse anything else, since it can't read what it
# stores (everything is end-to-end encrypted).
#
# Storage per account: 100 MiB (tens of thousands of notes).
QUOTA_BYTES=104857600
# Largest single file: 2 MiB (a very long note is still under 1 MiB).
MAX_FILE_BYTES=2097152
# Files per account.
MAX_FILES=20000
# Uploads plus downloads per account per day: 1 GiB. Bounds your bandwidth bill. 0 turns it off.
TRANSFER_BYTES_PER_DAY=1073741824
# Most accounts this server takes (0 = no limit). 100 accounts x 100 MiB fits a 20 GiB disk.
MAX_USERS=100

# Set to false to stop new sign-ups (existing accounts keep working).
ALLOW_SIGNUP=true

# Optional: keep encrypted files in S3 instead of the server's disk.
# The instance needs an IAM role allowing s3:GetObject, s3:PutObject and s3:DeleteObject on the bucket.
S3_BUCKET=
S3_REGION=

# Optional: pin a specific server version instead of latest.
# SYNC_IMAGE=ghcr.io/nabhyaraj-sonagara/basalt-sync:v0.3.0

# Used by backup.sh: an S3 location for nightly database dumps, e.g. s3://my-bucket/basalt-backups
BACKUP_S3_URI=
